# Public repo: nothing with credentials, tokens or org data.

# Secrets and credentials
.env
.env.*
*.key
*.pem
*.p12
*.crt
server.key
authUrl*.txt
*sfdxAuthUrl*

# Local configuration on each machine
.cursor/mcp.json
CLAUDE.local.md
.claude/settings.local.json

# Editor settings stay on each machine; only the recommended extensions list is shared
.vscode/*
!.vscode/extensions.json

# Salesforce CLI and the local LWC server
.sf/
.sfdx/
.localdevserver/
deploy-options.json

# LWC and Aura autocomplete in the editor
**/lwc/jsconfig.json
**/aura/jsconfig.json

# Node, lint and LWC tests
node_modules/
coverage/
.eslintcache
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating system
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
